{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vb6",
      "camelcase": "Vb6",
      "title": "VB6",
      "scope": "source.vb6",
      "file-types": ["bas", "cls"],
      "injection-regex": "^vb6$",
      "class-name": "TreeSitterVb6"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Visual Basic 6.0",
    "authors": [
      { "name": "tree-sitter-vb6 contributors" }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-vb6"
    }
  },
  "bindings": {
    "c": true, "go": true, "node": true,
    "python": true, "rust": true, "swift": true, "zig": false
  }
}
